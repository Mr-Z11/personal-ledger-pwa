# Local sync environment — copy to .env.local and fill in your values.
# This file is for the LOCAL docker-compose.local.yml, not the server one.

POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=ledger
DATABASE_URL=postgresql://ledger:change-this-to-a-strong-password@postgres-local:5432/ledger?schema=public

# Must be at least 24 characters. Use the SAME value as your cloud server
# so your existing login token still works after switching.
JWT_SECRET=replace-with-your-jwt-secret

# Prebuilt images from GitHub Container Registry (no local build needed).
API_IMAGE=ghcr.io/mr-z11/personal-ledger-pwa-api:main

# HTTPS port for local Caddy (default 8443 to avoid clashing with system services).
LOCAL_HTTPS_PORT=8443
