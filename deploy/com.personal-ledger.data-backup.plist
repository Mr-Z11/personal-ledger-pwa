<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personal-ledger.data-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/frori/Vibecoding/personal-ledger-pwa/scripts/auto-backup.sh</string>
    </array>

    <!-- Run at 00:00, 06:00, 12:00, 18:00 every day -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
        </dict>
    </array>

    <!-- Also run when the agent is first loaded (catches up on missed runs) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep it simple: don't keep alive, just run on schedule -->
    <key>KeepAlive</key>
    <false/>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Users/frori/Vibecoding/personal-ledger-pwa/backups/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/frori/Vibecoding/personal-ledger-pwa/backups/launchd-stderr.log</string>

    <!-- Use the user's shell environment for SSH access -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/frori</string>
    </dict>
</dict>
</plist>
