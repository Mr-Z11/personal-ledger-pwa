generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ledgers      Ledger[]
}

model Ledger {
  id            String        @id @default(uuid())
  name          String
  ownerId       String
  serverVersion Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  analysisNotes AnalysisNote[]
  plannedPurchases PlannedPurchase[]
  auditLogs     AuditLog[]

  @@index([ownerId])
}

model Account {
  id                  String        @id @default(uuid())
  ledgerId            String
  name                String
  type                String
  openingBalanceCents BigInt          @default(0)
  color               String
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  ledger              Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions        Transaction[] @relation("TransactionAccount")
  incomingTransfers   Transaction[] @relation("TransactionToAccount")

  @@index([ledgerId])
}

model Category {
  id           String        @id @default(uuid())
  ledgerId     String
  name         String
  kind         String
  parentId     String?
  icon         String
  color        String
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  ledger       Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([ledgerId])
  @@index([ledgerId, parentId])
}

model Transaction {
  id          String    @id @default(uuid())
  ledgerId    String
  type        String
  accountId   String
  toAccountId String?
  categoryId  String?
  amountCents BigInt
  occurredAt  DateTime
  note        String?
  merchant    String?
  tags        String[]  @default([])
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  account     Account   @relation("TransactionAccount", fields: [accountId], references: [id])
  toAccount   Account?  @relation("TransactionToAccount", fields: [toAccountId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([ledgerId, occurredAt])
  @@index([accountId])
  @@index([categoryId])
}

model Budget {
  id          String    @id @default(uuid())
  ledgerId    String
  categoryId  String?
  month       String
  amountCents BigInt
  scope       String    @default("daily")
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([ledgerId, month])
}

model AnalysisNote {
  id          String    @id @default(uuid())
  ledgerId    String
  month       String
  subjectType String
  subjectKey  String
  content     String
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId, month])
  @@unique([ledgerId, month, subjectType, subjectKey])
}

model PlannedPurchase {
  id          String    @id @default(uuid())
  ledgerId    String
  name        String
  amountCents BigInt
  note        String?
  completedAt DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId])
}

model ReminderSetting {
  id        String   @id @default(uuid())
  userId    String   @unique
  salaryDay Int      @default(10)
  remindHour Int     @default(9)
  content   String   @default("")
  enabled   Boolean  @default(true)
  /** 当日限额提醒：关闭后不推送（应用内全屏警告仍生效） */
  dailyLimitEnabled Boolean @default(true)
  /** 当日限额提醒时间（北京时间小时 0-23）：到点后才推送 */
  dailyLimitHour Int @default(21)
  /** 误差金额（分）：今日消费 ≥ 日限额 − 误差即视为达线 */
  dailyLimitToleranceCents Int @default(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ReminderLog {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  month     String
  sentAt    DateTime @default(now())

  @@unique([userId, kind, month])
}

model AuditLog {
  id        String   @id @default(uuid())
  ledgerId  String
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId, createdAt])
}
